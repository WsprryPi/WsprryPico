  "narrative": {
    "overview": "This record applies to `src/network/web/index.html`, `style.css`, and `app.js`.\nIt captures the existing embedded operator interface after the finite-message\nchanges. No new brand metaphor, visual identity, or approved composition is\nestablished. WsprryPi has its own design record; its fonts, Bootstrap components,\nand theme rules are not dependencies of this embedded surface.\n\nThe interface presents station state and editable forms in a centered light\npage beneath a navy header. Technical values, plain labels, inline help, and\nexplicit recovery messages carry the hierarchy. Timing belongs to the Pico;\nthe browser prepares complete jobs and reports observations.",
    "keyCharacteristics": [
      "Flat sections separated by borders and spacing.",
      "Native controls with visible keyboard focus and explicit labels.",
      "Inline validation that preserves the entered draft.",
      "Exact finite-job duration and numerical event capacity.",
      "Confirmed status remains separate from estimated progress."
    ],
    "rules": [
      {
        "name": "The Preserved Draft Rule",
        "body": "Reject invalid input with an explanation; retain the entered message for correction rather than truncating it or silently splitting it into jobs.",
        "section": "components"
      },
      {
        "name": "The Confirmed State Rule",
        "body": "Estimated elapsed time may describe a matching running job, but never replace its last confirmed state or turn a completed estimate into confirmed completion.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve the light canvas, navy header, and existing native form styles.",
      "**Do** expose exact duration, character count, and numerical event capacity.",
      "**Do** keep units, validation guidance, visible focus, and status announcements.",
      "**Do** preserve invalid drafts and explicit unknown device states."
    ],
    "donts": [
      "**Don't** truncate, split, or silently reduce an invalid message to fit limits.",
      "**Don't** use elapsed time or a lost connection as evidence of RF state.",
      "**Don't** import WsprryPi's separate theme or typography as an embedded UI rule."
    ]
  }
}
