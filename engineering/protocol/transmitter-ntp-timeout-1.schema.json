{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsprry:transmitter-ntp-timeout:1",
  "oneOf": [
    {
      "$ref": "#/$defs/write"
    },
    {
      "$ref": "#/$defs/read"
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "device_id",
        "boot_id"
      ],
      "properties": {
        "scope": {
          "const": "member"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 86400,
      "multipleOf": 60
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "timeout_s"
      ],
      "properties": {
        "schema": {
          "const": "transmitter-ntp-timeout/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "timeout_s": {
          "$ref": "#/$defs/seconds"
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "saved_timeout_s",
        "active_timeout_s",
        "pending_restart",
        "storage_healthy"
      ],
      "properties": {
        "schema": {
          "const": "transmitter-ntp-timeout/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "saved_timeout_s": {
          "$ref": "#/$defs/seconds"
        },
        "active_timeout_s": {
          "$ref": "#/$defs/seconds"
        },
        "pending_restart": {
          "type": "boolean"
        },
        "storage_healthy": {
          "type": "boolean"
        }
      }
    }
  }
}
