{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WsprryPi/WsprryPico/udp-logging-capabilities-1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "resource",
        "settings_schema",
        "wire_schema",
        "limits"
      ],
      "properties": {
        "schema": {
          "const": "udp-logging-capabilities/1"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "device_id",
            "boot_id"
          ],
          "properties": {
            "scope": {
              "const": "member"
            },
            "device_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32,
              "pattern": "^[0-9a-f]{32}$"
            },
            "boot_id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32,
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "resource": {
          "const": "/api/v1/udp-logging"
        },
        "settings_schema": {
          "const": "transmitter-udp-logging/1"
        },
        "wire_schema": {
          "const": "wsprry-udp/1"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_bytes",
            "queue_records",
            "maximum_sources",
            "maximum_peers",
            "maximum_rate",
            "maximum_burst",
            "address_family"
          ],
          "properties": {
            "payload_bytes": {
              "const": 480
            },
            "queue_records": {
              "const": 16
            },
            "maximum_sources": {
              "const": 0
            },
            "maximum_peers": {
              "const": 0
            },
            "maximum_rate": {
              "const": 8
            },
            "maximum_burst": {
              "const": 16
            },
            "address_family": {
              "const": "ipv4"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "resource",
        "settings_schema",
        "wire_schema",
        "limits"
      ],
      "properties": {
        "schema": {
          "const": "udp-logging-capabilities/1"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "collector_id"
          ],
          "properties": {
            "scope": {
              "const": "host"
            },
            "collector_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "resource": {
          "const": "/api/v1/host/udp-logging"
        },
        "settings_schema": {
          "const": "host-udp-logging/1"
        },
        "wire_schema": {
          "const": "wsprry-udp/1"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payload_bytes",
            "queue_records",
            "maximum_sources",
            "maximum_peers",
            "maximum_rate",
            "maximum_burst",
            "address_family"
          ],
          "properties": {
            "payload_bytes": {
              "const": 480
            },
            "queue_records": {
              "const": 256
            },
            "maximum_sources": {
              "const": 8
            },
            "maximum_peers": {
              "const": 32
            },
            "maximum_rate": {
              "const": 64
            },
            "maximum_burst": {
              "const": 128
            },
            "address_family": {
              "const": "ipv4"
            }
          }
        }
      }
    }
  ]
}
