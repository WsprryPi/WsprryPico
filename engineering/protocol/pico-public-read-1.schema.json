{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico public read discovery version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "prefix",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "pico-public-read/1"
    },
    "prefix": {
      "const": "/api/consumer/v1/read/"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "device_id",
        "boot_id"
      ],
      "properties": {
        "scope": {
          "const": "member"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "resources": {
      "const": [
        "capabilities",
        "pins",
        "pins/2",
        "operations",
        "status",
        "config",
        "config/2",
        "config/3",
        "config/4",
        "application",
        "application/2",
        "application/3",
        "application/4",
        "station",
        "station/2",
        "hardware",
        "hardware/2",
        "hardware/3",
        "progress",
        "progress/2",
        "progress/3",
        "rf-calibration",
        "standalone-frequency",
        "gpio-drive",
        "ntp-timeout",
        "filter-selector",
        "hostname",
        "logging",
        "udp-logging",
        "udp-logging/capabilities",
        "udp-logging/test/capabilities",
        "message-schedule",
        "consumer/password",
        "consumer/setup/api/owner/v1/public-status"
      ]
    }
  }
}
