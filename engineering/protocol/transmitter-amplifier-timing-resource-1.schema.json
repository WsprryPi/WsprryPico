{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsprry:transmitter-amplifier-timing-resource:1",
  "title": "Amplifier timing request and response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "timing"
      ],
      "properties": {
        "schema": {
          "const": "transmitter-amplifier-timing/1"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "device_id",
            "boot_id"
          ],
          "properties": {
            "scope": {
              "const": "member"
            },
            "device_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "boot_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lead_ms",
            "tail_ms"
          ],
          "properties": {
            "lead_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "tail_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "target",
        "saved",
        "boot_active",
        "pending_restart",
        "phase",
        "output_active",
        "rf_active",
        "storage_healthy"
      ],
      "properties": {
        "schema": {
          "const": "transmitter-amplifier-timing/1"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "device_id",
            "boot_id"
          ],
          "properties": {
            "scope": {
              "const": "member"
            },
            "device_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "boot_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        },
        "saved": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lead_ms",
                "tail_ms"
              ],
              "properties": {
                "lead_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "tail_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "boot_active": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lead_ms",
                "tail_ms"
              ],
              "properties": {
                "lead_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "tail_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_restart": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "inactive",
            "waiting",
            "lead",
            "rf",
            "tail",
            "fault"
          ]
        },
        "output_active": {
          "type": "boolean"
        },
        "rf_active": {
          "type": "boolean"
        },
        "storage_healthy": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "rf"
              }
            }
          },
          "then": {
            "properties": {
              "rf_active": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "rf_active": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "lead",
                  "rf",
                  "tail"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "output_active": {
                "const": true
              }
            }
          }
        }
      ]
    }
  ]
}
