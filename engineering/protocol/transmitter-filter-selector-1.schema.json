{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "settings"
  ],
  "properties": {
    "schema": {
      "const": "transmitter-filter-selector/1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "device_id",
        "boot_id"
      ],
      "properties": {
        "scope": {
          "const": "member"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "release_ms",
        "settle_ms",
        "selectors",
        "ranges"
      ],
      "properties": {
        "policy": {
          "enum": [
            "fixed_manual",
            "required"
          ]
        },
        "release_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "settle_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 250
        },
        "selectors": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "gp",
              "active_high"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[A-Za-z0-9_/-](?:[A-Za-z0-9 _/-]{0,14}[A-Za-z0-9_/-])?$"
              },
              "gp": {
                "type": "integer",
                "anyOf": [
                  {
                    "minimum": 0,
                    "maximum": 22
                  },
                  {
                    "minimum": 26,
                    "maximum": 28
                  }
                ]
              },
              "active_high": {
                "type": "boolean"
              }
            }
          }
        },
        "ranges": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "selector",
              "low_hz",
              "high_hz"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16,
                "pattern": "^[A-Za-z0-9_/-](?:[A-Za-z0-9 _/-]{0,14}[A-Za-z0-9_/-])?$"
              },
              "selector": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "low_hz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              },
              "high_hz": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000000000
              }
            }
          }
        }
      }
    }
  }
}
