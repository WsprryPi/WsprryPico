{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico public amplifier timing reads version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "prefix",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "pico-public-read/2"
    },
    "prefix": {
      "const": "/api/consumer/v1/read/2/"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "device_id",
        "boot_id"
      ],
      "properties": {
        "scope": {
          "const": "member"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "resources": {
      "const": [
        "amplifier-timing"
      ]
    }
  }
}
