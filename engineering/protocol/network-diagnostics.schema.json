    "control_listening": {
      "type": "boolean"
    },
    "consumer_web_ready": {
      "type": "boolean"
    },
    "consumer_web_port": {
      "const": 80
    },
    "deployment_identity_matches": {
      "type": "boolean"
    },
    "station_mac": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2}(?::[0-9a-f]{2}){5})?$(?![\\s\\S])"
    },
    "stable_hostname": {
      "type": "string",
      "maxLength": 69,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.local)?$(?![\\s\\S])"
    },
    "configured_hostname": {
      "type": "string",
      "maxLength": 69,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.local)?$(?![\\s\\S])"
    },
    "advertised_hostname": {
      "type": "string",
      "maxLength": 69,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.local)?$(?![\\s\\S])"
    },
    "mdns_state": {
      "enum": [
        "unconfigured",
        "waiting_address",
        "probing",
        "active",
        "withdrawing",
        "conflict",
        "failed"
