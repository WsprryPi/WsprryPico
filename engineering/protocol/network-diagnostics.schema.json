{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pico network diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ntp_observations",
    "ntp_rate",
    "ntp_learning",
    "ntp_pool",
    "initialized",
    "enabled",
    "link_status",
    "ipv4",
    "softap_netif",
    "requested_enabled",
    "withdrawal_pending",
    "resume_after_withdrawal",
    "control_configured",
    "control_listening",
    "consumer_web_ready",
    "consumer_web_port",
    "deployment_identity_matches",
    "station_mac",
    "stable_hostname",
    "configured_hostname",
    "advertised_hostname",
    "mdns_state",
    "mdns_reason",
    "mdns_registrations",
    "mdns_conflicts",
    "mdns_failures",
    "mdns_address_changes",
    "mdns_goodbye_attempts",
    "mdns_goodbye_failures",
    "mdns_rejected_packets",
    "power_save",
    "packets",
    "memory",
    "ntp_server",
    "ntp_address",
    "ntp_resolution",
    "ntp_resolution_failures",
    "queries",
    "accepted",
    "rejected",
    "last_rtt_ns",
    "last_sample_uncertainty_ns"
  ],
  "properties": {
    "ntp_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "packet_accepted",
        "arbiter_accepted_this_packet",
        "last_accepted_measurement"
      ],
      "properties": {
        "source": {
          "const": "microchrony"
        },
        "packet_accepted": {
          "type": "boolean"
        },
        "arbiter_accepted_this_packet": {
          "type": "boolean"
        },
        "last_accepted_measurement": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "clock_epoch",
                "send_raw_ns",
                "receive_raw_ns",
                "reference_utc_ns",
                "uncertainty_ns",
                "rtt_ns",
                "server_reference_ns",
                "server_receive_ns",
                "server_send_ns",
                "root_delay_16_16",
                "root_dispersion_16_16",
                "stratum",
                "leap",
                "precision"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "clock_epoch": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "send_raw_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "receive_raw_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "reference_utc_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "uncertainty_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "rtt_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "server_reference_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "server_receive_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "server_send_ns": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,19})$",
                  "x-maximum": "18446744073709551615"
                },
                "root_delay_16_16": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "root_dispersion_16_16": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "stratum": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "leap": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "precision": {
                  "type": "integer",
                  "minimum": -128,
                  "maximum": 127
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ntp_rate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualified",
        "utc_rate_ppb",
        "uncertainty_ppb",
        "generation",
        "sampled_raw_ns",
        "span_ns",
        "samples",
        "reason"
      ],
      "properties": {
        "qualified": {
          "type": "boolean"
        },
        "utc_rate_ppb": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "uncertainty_ppb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "generation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "x-maximum": "18446744073709551615"
        },
        "sampled_raw_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "x-maximum": "18446744073709551615"
        },
        "span_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "x-maximum": "18446744073709551615"
        },
        "samples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "reason": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "ntp_learning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "synchronized",
        "phase_settled",
        "rate_settled",
        "utc_frequency_ppb",
        "skew_ppb",
        "remaining_correction_ns",
        "clock_error_ns",
        "rate_ppb",
        "rf_candidate"
      ],
      "properties": {
        "schema": {
          "const": "microchrony-status/1"
        },
        "synchronized": {
          "type": "boolean"
        },
        "phase_settled": {
          "type": "boolean"
        },
        "rate_settled": {
          "type": "boolean"
        },
        "utc_frequency_ppb": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "skew_ppb": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "remaining_correction_ns": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,18})$"
        },
        "clock_error_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$",
          "x-maximum": "18446744073709551615"
        },
        "rate_ppb": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "rf_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "qualified",
            "utc_rate_ppb",
            "uncertainty_ppb",
            "generation",
            "sampled_raw_ns",
            "span_ns",
            "samples",
            "reason"
          ],
          "properties": {
            "qualified": {
              "type": "boolean"
            },
            "utc_rate_ppb": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "uncertainty_ppb": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "generation": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "x-maximum": "18446744073709551615"
            },
            "sampled_raw_ns": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "x-maximum": "18446744073709551615"
            },
            "span_ns": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,19})$",
              "x-maximum": "18446744073709551615"
            },
            "samples": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "reason": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    "ntp_pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "enabled",
        "selected_slot",
        "combined_sources",
        "utc_updates",
