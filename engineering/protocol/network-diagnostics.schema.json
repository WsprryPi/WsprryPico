          "minimum": 0,
          "maximum": 4294967295
        },
        "utc_updates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "peers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "slot",
              "hostname",
              "endpoint",
              "queries",
              "accepted",
              "rejected",
              "selection_score_milli",
              "reach",
              "max_process_us",
              "poll_seconds",
              "selected",
              "combined",
              "reason"
            ],
            "properties": {
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "hostname": {
                "type": "string",
                "maxLength": 253
              },
              "endpoint": {
                "type": "string",
                "maxLength": 15,
                "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|)$"
              },
              "queries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "accepted": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "rejected": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "selection_score_milli": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000000
              },
              "reach": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "max_process_us": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "poll_seconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "selected": {
                "type": "boolean"
              },
              "combined": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        }
      }
    },
    "initialized": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "link_status": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647
    },
    "ipv4": {
      "type": "string",
      "maxLength": 15,
      "pattern": "^(?:(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|)$"
    },
    "softap_netif": {
      "type": "object",
      "additionalProperties": false,
