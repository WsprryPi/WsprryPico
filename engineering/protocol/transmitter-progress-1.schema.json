{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsprry:transmitter-progress:1",
  "title": "Independent saved progress, explicit update and application",
  "description": "Structural envelope schema; see saved-progress.md and production validators for field, byte, uint64, authority and cross-field bounds. No runnable configuration or readiness guarantee.",
  "oneOf": [
    {
      "$ref": "#/$defs/read"
    },
    {
      "$ref": "#/$defs/update"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/apply"
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "member"
        },
        "device_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "scope",
        "device_id",
        "boot_id"
      ]
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical uint64 decimal; semantic validator enforces uint64 maximum."
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callsign": {
          "oneOf": [
            {
              "maxLength": 12,
              "type": "string"
            },
            {
              "maxLength": 12,
              "type": "null"
            }
          ]
        },
        "locator": {
          "oneOf": [
            {
              "pattern": "^[A-R]{2}[0-9]{2}([A-X]{2})?$",
              "type": "string"
            },
            {
              "pattern": "^[A-R]{2}[0-9]{2}([A-X]{2})?$",
              "type": "null"
            }
          ]
        },
        "power_dbm": {
          "enum": [
            null,
            0,
            3,
            7,
            10,
            13,
            17,
            20,
            23,
            27,
            30,
            33,
            37,
            40,
            43,
            47,
            50,
            53,
            57,
            60
          ]
        }
      },
      "required": [
        "callsign",
        "locator",
        "power_dbm"
      ]
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "callsign": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "locator": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "power_dbm": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "enabled": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "schedules": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "expires_utc_s": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "pins": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "frequency_policy": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "wifi": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        },
        "ntp_ipv4": {
          "enum": [
            "saved",
            "cleared",
            "invalid"
          ]
        }
      },
      "required": []
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "transmitter-progress/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "draft_revision": {
          "$ref": "#/$defs/sequence"
        },
        "config_revision": {
          "$ref": "#/$defs/sequence"
        },
        "profile_revision": {
          "$ref": "#/$defs/sequence"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "callsign": {},
            "locator": {},
            "power_dbm": {},
            "enabled": {},
            "schedules": {},
            "expires_utc_s": {},
            "pins": {},
            "frequency_policy": {},
            "wifi": {},
            "ntp_ipv4": {}
          },
          "required": []
        },
        "last_receipt": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "null"
            }
          ]
        },
        "last_outcomes": {
          "$ref": "#/$defs/outcomes"
        },
        "applied_station": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/station"
            }
          ]
        },
        "station": {
          "$ref": "#/$defs/station"
        },
        "station_complete": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "apply_domains": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "station": {
              "type": "boolean"
            },
            "network": {
              "type": "boolean"
            },
            "radio": {
              "type": "boolean"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": [
            "station",
            "network",
            "radio",
            "all"
          ]
        },
        "wspr_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "Closed wspr-plan/1 resource; see versioned application schema and browser semantic validation."
            }
          ]
        },
        "schedule_enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule_suspended": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "matches_applied": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "target",
        "draft_revision",
        "config_revision",
        "profile_revision",
        "fields",
        "last_receipt",
        "last_outcomes",
        "applied_station",
        "station",
        "station_complete",
        "complete",
        "apply_domains",
        "wspr_plan",
        "schedule_enabled",
        "schedule_suspended",
        "matches_applied"
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "transmitter-progress/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "callsign": {},
            "locator": {},
            "power_dbm": {},
            "enabled": {},
            "schedules": {},
            "expires_utc_s": {},
            "pins": {},
            "frequency_policy": {},
            "wifi": {},
            "ntp_ipv4": {}
          },
          "required": [],
          "minProperties": 1,
          "maxProperties": 10,
          "description": "Known invalid units are permitted in updates for independent per-unit outcomes. The bounded firmware JSON parser and field validators are authoritative."
        }
      },
      "required": [
        "schema",
        "target",
        "request_id",
        "fields"
      ]
    },
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "transmitter-progress/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "draft_revision": {
          "$ref": "#/$defs/sequence"
        },
        "config_revision": {
          "$ref": "#/$defs/sequence"
        },
        "profile_revision": {
          "$ref": "#/$defs/sequence"
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "callsign": {},
            "locator": {},
            "power_dbm": {},
            "enabled": {},
            "schedules": {},
            "expires_utc_s": {},
            "pins": {},
            "frequency_policy": {},
            "wifi": {},
            "ntp_ipv4": {}
          },
          "required": []
        },
        "last_receipt": {
          "oneOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "null"
            }
          ]
        },
        "last_outcomes": {
          "$ref": "#/$defs/outcomes"
        },
        "applied_station": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/station"
            }
          ]
        },
        "station": {
          "$ref": "#/$defs/station"
        },
        "station_complete": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "apply_domains": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "station": {
              "type": "boolean"
            },
            "network": {
              "type": "boolean"
            },
            "radio": {
              "type": "boolean"
            },
            "all": {
              "type": "boolean"
            }
          },
          "required": [
            "station",
            "network",
            "radio",
            "all"
          ]
        },
        "wspr_plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "description": "Closed wspr-plan/1 resource; see versioned application schema and browser semantic validation."
            }
          ]
        },
        "schedule_enabled": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "schedule_suspended": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "matches_applied": {
          "type": "boolean"
        },
        "outcomes": {
          "$ref": "#/$defs/outcomes"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      },
      "required": [
        "schema",
        "target",
        "draft_revision",
        "config_revision",
        "profile_revision",
        "fields",
        "last_receipt",
        "last_outcomes",
        "applied_station",
        "station",
        "station_complete",
        "complete",
        "apply_domains",
        "wspr_plan",
        "schedule_enabled",
        "schedule_suspended",
        "matches_applied",
        "outcomes",
        "request_id"
      ]
    },
    "apply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "transmitter-progress/1"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "draft_revision": {
              "$ref": "#/$defs/sequence"
            },
            "domain": {
              "enum": [
                "station",
                "network",
                "radio",
                "all"
              ]
            }
          },
          "required": [
            "draft_revision",
            "domain"
          ]
        }
      },
      "required": [
        "schema",
        "target",
        "application"
      ]
    }
  }
}
