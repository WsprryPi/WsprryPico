{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wsprry:amplifier-readback:1",
  "title": "Last-job board-readback timing in extensible Console INFO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "epoch",
    "configured",
    "lead_ms",
    "tail_ms",
    "normal_rf_completion",
    "enable_verified_ns",
    "rf_launch_ns",
    "rf_inactive_verified_ns",
    "disable_verified_ns"
  ],
  "properties": {
    "schema": {
      "const": "amplifier-readback/1"
    },
    "epoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "configured": {
      "type": "boolean"
    },
    "lead_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "tail_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "normal_rf_completion": {
      "type": "boolean"
    },
    "enable_verified_ns": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "rf_launch_ns": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "rf_inactive_verified_ns": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    },
    "disable_verified_ns": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,19}$"
        }
      ]
    }
  }
}
